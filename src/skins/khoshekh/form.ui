  </property>
  <property name="styleSheet">
   <string notr="true">/* TrackDeck "Khoshekh" skin: the Khoshekh setting sun, teal colourway */

#borderWidget {
	background: #05070F;
	border: 1px solid #12303A;
}

#splitTop {
	background: #05070F;
}

/* title bar */
#titleLabel {
	color: #7FA3AA;
	font-size: 12px;
}
#minimizeButton, #closeButton, #menuButton {
	border: none;
	border-radius: 6px;
	background: transparent;
	padding: 2px;
}
#minimizeButton:hover, #menuButton:hover {
	background: #0E2630;
}
#closeButton:hover {
	background: #E5484D;
}
#minimizeButton:pressed, #menuButton:pressed {
	background: #12303A;
}
#closeButton { qproperty-icon: url(close.svg); }
#minimizeButton { qproperty-icon: url(minimize.svg); }
#menuButton { qproperty-icon: url(menu.svg); }

/* now playing header */
#coverWidget {
	background: #0A1420;
	border: 1px solid #12303A;
	border-radius: 8px;
}
#coverWidget:hover {
	border: 1px solid #2F8F9A;
}
#trackTitleLabel {
	color: #F2ECE2;
	font-size: 20px;
	font-weight: 600;
}
#trackArtistLabel {
	color: #BFD6D8;
	font-size: 14px;
}
#trackMetaLabel {
	color: #6CC3CC;
	font-size: 12px;
	font-weight: 600;
}

/* waveform */
#waveformSlider {
	qproperty-radius: 8;
	qproperty-background: #0A1420;
	qproperty-wave_background: #1E5F6E;
	qproperty-wave_border_color: #3FA9B5;
	qproperty-progress_playing_background: #2F8F9A;
	qproperty-progress_paused_background: #8A6D2F;
	qproperty-playing_composition: Overlay;
	qproperty-paused_composition: Overlay;
	qproperty-groove_playing_background: #FFFFFF;
	qproperty-groove_paused_background: #C9A24A;
	qproperty-file_drop_border_color: #2F8F9A;
	qproperty-file_drop_background: rgba(47, 143, 154, 40);
}
NTrackInfoWidget {
	margin: 4;
}
NTrackInfoWidget QLabel {
	color: #F2ECE2;
	font-size: 11px;
	font-weight: 600;
	max-height: 16px;
	background: rgba(15, 17, 21, 190);
	border-radius: 4px;
	padding: 0 4;
}
NTrackInfoWidget #MiddleCenter {
	font-size: 13px;
}

/* transport */
#prevButton, #nextButton, #stopButton,
#shuffleButton, #repeatButton {
	border: none;
	border-radius: 18px;
	background: transparent;
}
#prevButton:hover, #nextButton:hover, #stopButton:hover,
#shuffleButton:hover, #repeatButton:hover {
	background: #0E2630;
}
#prevButton:pressed, #nextButton:pressed, #stopButton:pressed,
#shuffleButton:pressed, #repeatButton:pressed {
	background: #12303A;
}
#shuffleButton:checked, #repeatButton:checked {
	background: rgba(47, 143, 154, 45);
}
#shuffleButton:checked:hover, #repeatButton:checked:hover {
	background: rgba(47, 143, 154, 70);
}
#playButton {
	border: none;
	border-radius: 24px;
	background: #2F8F9A;
}
#playButton:hover {
	background: #3FA9B5;
}
#playButton:pressed {
	background: #24707A;
}
#prevButton { qproperty-icon: url(prev.svg); }
#nextButton { qproperty-icon: url(next.svg); }
#stopButton { qproperty-icon: url(stop.svg); }
#playButton { qproperty-icon: url(play.svg); }
#shuffleButton { qproperty-icon: url(shuffle.svg); }
#repeatButton { qproperty-icon: url(repeat.svg); }

#volumeIcon {
	image: url(volume.svg);
}
#volumeSlider::groove:horizontal {
	background: #12303A;
	height: 4px;
	border-radius: 2px;
}
#volumeSlider::sub-page:horizontal {
	background: #2F8F9A;
	border-radius: 2px;
}
#volumeSlider::handle:horizontal {
	background: #F2ECE2;
	width: 12px;
	height: 12px;
	margin: -4px 0;
	border-radius: 6px;
}
#volumeSlider::handle:horizontal:hover {
	background: #FFFFFF;
	border: 2px solid #2F8F9A;
	width: 10px;
	height: 10px;
}

#mainWindow &gt; QSizeGrip, #sizeGrip {
	image: url(grip.svg);
	width: 14px;
	height: 14px;
}

/* splitter between player and playlist */
#splitter {
	background: #05070F;
}
#splitter::handle {
	background: #05070F;
	border-top: 1px solid #0E2630;
}
#splitter::handle:hover {
	border-top: 1px solid #2F8F9A;
}

/* playlist */
#playlistWidget {
	color: #BFD6D8;
	background: #05070F;
	border: none;
	padding: 4px 8px;
	outline: none;
	qproperty-playing_text_color: #6CC3CC;
	qproperty-failed_text_color: #4A5A60;
	qproperty-file_drop_border_color: #2F8F9A;
	qproperty-file_drop_background: rgba(47, 143, 154, 40);
	qproperty-file_drop_radius: 8;
}
#playlistWidget::item {
	padding: 5px 4px;
	border: none;
	border-radius: 6px;
	margin: 1px 0;
}
#playlistWidget::item:hover {
	background: #0A1420;
}
#playlistWidget::item:selected {
	background: rgba(47, 143, 154, 38);
	color: #F2ECE2;
}
#playlistWidget::item:selected:hover {
	background: rgba(47, 143, 154, 55);
}
#playlistWidget QScrollBar:vertical {
	background: transparent;
	width: 10px;
	margin: 4px 0;
}
#playlistWidget QScrollBar::handle:vertical {
	background: #12303A;
	border-radius: 4px;
	min-height: 32px;
	margin: 0 2px;
}
#playlistWidget QScrollBar::handle:vertical:hover {
	background: #2F8F9A;
}
#playlistWidget QScrollBar::add-line, #playlistWidget QScrollBar::sub-line,
#playlistWidget QScrollBar::add-page, #playlistWidget QScrollBar::sub-page {
	height: 0px;
	background: transparent;
}

/* pop-up menus (context menu, playlist menu) */
QMenu {
	background: #0A1420;
	border: 1px solid #1E5F6E;
	padding: 6px 0;
}
QMenu::item {
	color: #E9E2D6;
	background: transparent;
	padding: 6px 28px 6px 30px;
	margin: 0 6px;
	border-radius: 5px;
}
QMenu::item:selected {
	background: #2F8F9A;
	color: #FFFFFF;
}
QMenu::item:disabled {
	color: #4A5A60;
	background: transparent;
}
QMenu::separator {
	height: 1px;
	background: #12303A;
	margin: 5px 12px;
}
QMenu::indicator {
	width: 14px;
	height: 14px;
	left: 10px;
}
QMenu::indicator:checked {
	image: url(check.svg);
}
QMenu::right-arrow {
	image: url(chevron.svg);
	width: 12px;
	height: 12px;
	margin-right: 10px;
}
QMenu::icon {
	padding-left: 10px;
}

QToolTip {
	color: #F2ECE2;
	background: #0E2630;
	border: 1px solid #12303A;
	border-radius: 4px;
	padding: 4px;
}

/* --- Khoshekh: sky with the setting sun above, the water below --------- */
#splitTop {
	/* teal horizon glow rising from the bottom of the header (no sun:
	   the cream sun hid the cream controls) */
	background: qradialgradient(cx: 0.5, cy: 1.15, radius: 0.85, fx: 0.5, fy: 1.0,
		stop: 0 rgba(47, 143, 154, 150), stop: 0.45 rgba(30, 95, 110, 70), stop: 1 #05070F);
}
#waveformSlider {
	qproperty-background: rgba(5, 7, 15, 150);
}
#coverWidget {
	background: rgba(10, 20, 32, 160);
}
#splitter::handle {
	background: #02040A;
	border-top: 1px solid rgba(191, 214, 216, 110);
}
#playlistWidget {
	background: #02040A;
}</string>
