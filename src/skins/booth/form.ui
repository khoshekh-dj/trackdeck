<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>mainWindow</class>
 <widget class="QDialog" name="mainWindow">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>760</width>
    <height>560</height>
   </rect>
  </property>
  <property name="styleSheet">
   <string notr="true">/* TrackDeck "Booth" skin: an original look inspired by club DJ booth gear:
   graphite panels, a black player screen with segment-display readouts and
   backlit round buttons. Accent (amber by default) follows Preferences. */

#borderWidget {
	background: #0B0C0E;
	border: 1px solid #24272D;
}
#splitTop {
	background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 #1A1C20, stop: 1 #101114);
}

/* title bar */
#titleLabel {
	color: #7C828C;
	font-size: 12px;
}
#minimizeButton, #closeButton, #menuButton {
	border: none;
	border-radius: 6px;
	background: transparent;
	padding: 2px;
}
#minimizeButton:hover, #menuButton:hover {
	background: #24272D;
}
#closeButton:hover {
	background: #E5484D;
}
#minimizeButton:pressed, #menuButton:pressed {
	background: #2E3138;
}
#closeButton { qproperty-icon: url(close.svg); }
#minimizeButton { qproperty-icon: url(minimize.svg); }
#menuButton { qproperty-icon: url(menu.svg); }

/* the player screen: a recessed black display */
#screenPanel {
	background: #050607;
	border: 1px solid #000000;
	border-bottom: 1px solid #2E3138;
	border-radius: 8px;
}
#coverWidget {
	background: #0F1013;
	border: 1px solid #24272D;
	border-radius: 4px;
}
#trackTitleLabel {
	color: #F2F4F7;
	font-size: 19px;
	font-weight: 600;
}
#trackArtistLabel {
	color: #A9AFB8;
	font-size: 13px;
}
#trackMetaLabel {
	color: #5E646E;
	font-size: 11px;
}
#bpmCaption, #keyCaption, #timeCaption {
	color: #7C828C;
	font-size: 9px;
	font-weight: 700;
	letter-spacing: 1px;
}
#bpmValue, #timeValue {
	color: #FF9F1A;
	font-size: 24px;
	/* the segment font is set by the script once it has loaded it */
}
#keyValue {
	color: #FF9F1A;
	font-size: 22px;
	font-weight: 700;
}

/* waveform */
#waveformSlider {
	qproperty-radius: 6;
	qproperty-background: #050607;
	qproperty-wave_background: #3A3F48;
	qproperty-wave_border_color: #6B7280;
	qproperty-progress_playing_background: #FF9F1A;
	qproperty-progress_paused_background: #8A6D2F;
	qproperty-playing_composition: Overlay;
	qproperty-paused_composition: Overlay;
	qproperty-groove_playing_background: #FFFFFF;
	qproperty-groove_paused_background: #FF9F1A;
	qproperty-file_drop_border_color: #FF9F1A;
	qproperty-file_drop_background: rgba(255, 159, 26, 40);
}
NTrackInfoWidget {
	margin: 4;
}
NTrackInfoWidget QLabel {
	color: #F2F4F7;
	font-size: 11px;
	font-weight: 600;
	max-height: 16px;
	background: rgba(5, 6, 7, 200);
	border-radius: 3px;
	padding: 0 4;
}
NTrackInfoWidget #MiddleCenter {
	font-size: 13px;
}

/* transport: round backlit buttons */
#prevButton, #nextButton, #shuffleButton, #repeatButton {
	border: 2px solid #2E3138;
	border-radius: 18px;
	background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 #23262B, stop: 1 #17191D);
	min-width: 32px; max-width: 32px;
	min-height: 32px; max-height: 32px;
}
#prevButton:hover, #nextButton:hover, #shuffleButton:hover, #repeatButton:hover {
	border-color: #4A4F58;
}
#prevButton:pressed, #nextButton:pressed, #shuffleButton:pressed, #repeatButton:pressed {
	background: #0F1013;
}
#shuffleButton:checked, #repeatButton:checked {
	border-color: #FF9F1A;
	background: rgba(255, 159, 26, 30);
}
/* the cue-style stop button: amber ring */
#stopButton {
	border: 2px solid #FF9F1A;
	border-radius: 18px;
	background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 #23262B, stop: 1 #17191D);
	min-width: 32px; max-width: 32px;
	min-height: 32px; max-height: 32px;
}
#stopButton:hover {
	background: rgba(255, 159, 26, 40);
}
/* play: a big ring, green while playing (set by the script) */
#playButton {
	border: 3px solid #FF9F1A;
	border-radius: 26px;
	background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 #23262B, stop: 1 #17191D);
	min-width: 46px; max-width: 46px;
	min-height: 46px; max-height: 46px;
}
#playButton:hover {
	background: #2A2D33;
}
#playButton:pressed {
	background: #0F1013;
}
#prevButton { qproperty-icon: url(prev.svg); }
#nextButton { qproperty-icon: url(next.svg); }
#stopButton { qproperty-icon: url(stop.svg); }
#playButton { qproperty-icon: url(play.svg); }
#shuffleButton { qproperty-icon: url(shuffle.svg); }
#repeatButton { qproperty-icon: url(repeat.svg); }

#volumeIcon {
	image: url(volume.svg);
}
#volumeSlider::groove:horizontal {
	background: #050607;
	height: 6px;
	border-radius: 3px;
	border: 1px solid #24272D;
}
#volumeSlider::sub-page:horizontal {
	background: #FF9F1A;
	border-radius: 3px;
}
#volumeSlider::handle:horizontal {
	background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 #E6E8EC, stop: 1 #A9AFB8);
	width: 10px;
	height: 18px;
	margin: -7px 0;
	border-radius: 2px;
}

#mainWindow &gt; QSizeGrip, #sizeGrip {
	image: url(grip.svg);
	width: 14px;
	height: 14px;
}

#splitter {
	background: #0B0C0E;
}
#splitter::handle {
	background: #0B0C0E;
	border-top: 1px solid #24272D;
}
#splitter::handle:hover {
	border-top: 1px solid #FF9F1A;
}

/* playlist: a compact browser with alternating rows */
#playlistWidget {
	color: #C9CED6;
	background: #0B0C0E;
	alternate-background-color: #111317;
	border: none;
	padding: 2px 6px;
	outline: none;
	qproperty-playing_text_color: #FF9F1A;
	qproperty-failed_text_color: #4A4F58;
	qproperty-file_drop_border_color: #FF9F1A;
	qproperty-file_drop_background: rgba(255, 159, 26, 40);
	qproperty-file_drop_radius: 6;
}
#playlistWidget::item {
	padding: 3px 4px;
	border: none;
	border-left: 3px solid transparent;
	margin: 0;
}
#playlistWidget::item:alternate {
	background: #111317;
}
#playlistWidget::item:hover {
	background: #1A1C20;
}
#playlistWidget::item:selected {
	background: #22252B;
	border-left: 3px solid #FF9F1A;
	color: #FFFFFF;
}
#playlistWidget QScrollBar:vertical {
	background: transparent;
	width: 10px;
	margin: 4px 0;
}
#playlistWidget QScrollBar::handle:vertical {
	background: #2E3138;
	border-radius: 4px;
	min-height: 32px;
	margin: 0 2px;
}
#playlistWidget QScrollBar::handle:vertical:hover {
	background: #FF9F1A;
}
#playlistWidget QScrollBar::add-line, #playlistWidget QScrollBar::sub-line,
#playlistWidget QScrollBar::add-page, #playlistWidget QScrollBar::sub-page {
	height: 0px;
	background: transparent;
}

QMenu {
	background: #16181C;
	border: 1px solid #2E3138;
	padding: 6px 0;
}
QMenu::item {
	color: #E6E8EC;
	background: transparent;
	padding: 6px 28px 6px 30px;
	margin: 0 6px;
	border-radius: 5px;
}
QMenu::item:selected {
	background: #FF9F1A;
	color: #0B0C0E;
}
QMenu::item:disabled {
	color: #4A4F58;
	background: transparent;
}
QMenu::separator {
	height: 1px;
	background: #24272D;
	margin: 5px 12px;
}
QMenu::indicator {
	width: 14px;
	height: 14px;
	left: 10px;
}
QMenu::indicator:checked {
	image: url(check.svg);
}
QMenu::right-arrow {
	image: url(chevron.svg);
	width: 12px;
	height: 12px;
	margin-right: 10px;
}
QMenu::icon {
	padding-left: 10px;
}

QToolTip {
	color: #F2F4F7;
	background: #16181C;
	border: 1px solid #2E3138;
	border-radius: 4px;
	padding: 4px;
}</string>
